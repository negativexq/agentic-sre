  "research_question": "Can an explicit causal-investigation architecture improve cross-component exploration and causal-evidence acquisition over the frozen v0.2.0 single-investigator baseline while preserving deterministic evidence authority, bounded execution, and zero-write safety?",
  "hypotheses": {
    "H1": "An architecture that explicitly separates symptom analysis, causal exploration, and evidence challenge improves causal-component identification and causal-evidence coverage over v0.2.0 without reducing evidence-reference integrity or safety.",
    "H0": "The additional architecture does not materially improve causal attribution or causal-evidence acquisition over v0.2.0 under the same frozen compatibility scenarios and a predeclared bounded budget."
  },
  "architecture": {
    "candidates": [
      "A_IMPROVED_SINGLE_AGENT",
      "B_SINGLE_AGENT_DETERMINISTIC_VALIDATOR",
      "C_INVESTIGATOR_CRITIC",
      "D_SPECIALIZED_EVIDENCE_AGENTS"
    ],
    "selected": "C_INVESTIGATOR_CRITIC",
    "selection_reason": "Candidate C is the smallest candidate that independently tests evidence gathering, cross-component causal exploration, and evidence challenge without introducing a specialized-agent swarm.",
    "orchestration": "explicit_in_process_typed_state_machine",
    "roles": ["INVESTIGATOR", "CRITIC"],
    "no_specialized_swarm": true
  },
  "selection_criteria": {
